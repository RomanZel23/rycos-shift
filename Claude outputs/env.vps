# ===========================================================================
# RYCOS Shift — środowisko PRODUKCYJNE
#
# UWAGA przy Coolify: to NIE jest plik, z którego Coolify czyta zmienne.
# Coolify wstrzykuje własne Environment Variables ustawione w panelu aplikacji.
# Ten plik służy do:
#   - ręcznego `docker compose up -d --build` na VPS z pominięciem Coolify,
#   - trzymania w jednym miejscu wartości, które wklejasz do panelu Coolify.
#
# Plik jest w .gitignore i .dockerignore. Nie commitować.
# ===========================================================================

# --- Etap 0: bramka dostępu ------------------------------------------------
# APP_ACCESS_CODE: kod, który brygadzista wpisuje raz na telefonie.
# Bez tej zmiennej produkcja celowo blokuje całe /api/* (HTTP 503).
# GATE_SECRET: podpis ciasteczka bramki. Zmiana = wylogowanie wszystkich urządzeń.


# --- Resend ----------------------------------------------------------------
# UZUPEŁNIJ nowym kluczem po rotacji (stary trzeba skasować w panelu Resend).
RESEND_API_KEY=
RESEND_FROM_EMAIL=raporty@shift.rycos.eu

# --- Supabase --------------------------------------------------------------
# UZUPEŁNIJ po rotacji kluczy.
# NEXT_PUBLIC_* muszą być dostępne W CZASIE BUILDA (w Coolify: zaznacz
# "Build Variable" przy obu). SUPABASE_SERVICE_ROLE_KEY wyłącznie runtime —
# jako build arg zostałby na stałe w warstwie obrazu.
NEXT_PUBLIC_SUPABASE_URL=https://TWOJ-PROJEKT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Pozostałe -------------------------------------------------------------
PORT=3000
